DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=5001
FRONTEND_URL="http://localhost:5173"
# Set to true in local dev to return a reset link in the API response (no email server required)
EXPOSE_RESET_LINK="true"
# Comma-separated origins allowed to call the API (required when frontend is on Netlify)
# CORS_ORIGIN="https://your-app.netlify.app"
